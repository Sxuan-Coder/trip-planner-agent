# LLM 客户端配置
API_KEY="your-api-key-here"
BASE_URL="https://api.example.com/v1"
MODEL_ID="your-model-id"

# Tavily 搜索 API 配置（用于工具调用）
TAVILY_API_KEY="your-tavily-api-key"
